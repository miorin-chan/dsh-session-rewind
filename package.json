{
  "name": "@miorin/dsh-session-rewind",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Rewind to an earlier message, restore its text and attachments to the composer, and archive the original conversation.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rewind"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "DESIGN.md",
    "docs/README.md",
    "docs/DETAIL.zh.md",
    "docs/assets/screenshots",
    "README.zh.md",
    "lib"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:tools && node scripts/build.mjs",
    "build:tools": "tsc -p tsconfig.tools.json",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit --",
    "test:unit": "node --test",
    "check": "npm run build:tools && npm run test:unit && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-session-rewind.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-session-rewind#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-session-rewind/issues"
  }
}
